{% set margin = obj("top", 50, "right", 110, "bottom", 70, "left", 40) %}
{% set width  = 500 - margin.left - margin.right %}
{% set height = 400 - margin.top  - margin.bottom %}
{% set cats = ["Female","Male"] %}
{% set x = scaleBand() | domain(cats) | range(0, width) | padding(0.4) %}
{% set y = scaleLinear() | domain([0, 100]) | range(height, 0) %}
<svg width="{{width + margin.left + margin.right}}" height="{{height + margin.top + margin.bottom}}" xmlns="http://www.w3.org/2000/svg">
  <style>
    .tick-label  { font-family: sans-serif; font-size: 12px; fill: #333; }
    .title       { font-family: sans-serif; font-size: 13px; font-weight: bold; fill: #111; }
    .axis-label  { font-family: sans-serif; font-size: 12px; fill: #555; }
    .legend-text { font-family: sans-serif; font-size: 12px; fill: #333; }
    .pct-label   { font-family: sans-serif; font-size: 12px; fill: white; font-weight: bold; }
  </style>
  <g transform="translate({{margin.left}},{{margin.top}})">
    <text class="title" x="{{width / 2}}" y="-22" text-anchor="middle">Proporcion de Depresion por Genero</text>
    <g transform="translate(0,{{height}})">{{ call(axisBottom(x) | tickValues(cats)) }}</g>
    {% for d in data %}
      {% set bx   = scale(x, d.Genero) %}
      {% set bw   = bandwidth(x) %}
      {% set bwh  = bw / 2 %}
      {% set yYes = scale(y, d.PctYes) %}
      {% set hYes = height - scale(y, d.PctYes) %}
      {% set hYsh = hYes / 2 %}
      {% set lblX = bx + bwh %}
      {% set lblY = yYes + hYsh + 5 %}
      <rect x="{{bx}}" y="0" width="{{bw}}" height="{{height}}" fill="#F4C430"/>
      <rect x="{{bx}}" y="{{yYes}}" width="{{bw}}" height="{{hYes}}" fill="#2D68C4"/>
      <text class="pct-label" text-anchor="middle" x="{{lblX}}" y="{{lblY}}">{{d.PctYes}}%</text>
    {% endfor %}
    <text class="axis-label" text-anchor="middle" x="{{width / 2}}" y="{{height + 50}}">Genero</text>
    {% set legW  = width + 10 %}
    {% set legW2 = width + 28 %}
    <rect x="{{legW}}" y="0"  width="14" height="14" fill="#F4C430"/>
    <text class="legend-text" x="{{legW2}}" y="12">No</text>
    <rect x="{{legW}}" y="22" width="14" height="14" fill="#2D68C4"/>
    <text class="legend-text" x="{{legW2}}" y="34">Yes</text>
    <text class="legend-text" x="{{legW}}" y="-8" font-weight="bold">Depresion</text>
  </g>
</svg>