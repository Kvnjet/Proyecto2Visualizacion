{# set the dimensions and margins of the graph #}
{% set margin = obj("top", 50, "right", 30, "bottom", 80, "left", 70) %}
{% set width  = 560 - margin.left - margin.right %}
{% set height = 400 - margin.top  - margin.bottom %}

{% set cats = map(data, "CGPA") %}

{% set x = scaleBand()
      | domain(cats)
      | range(0, width)
      | padding(0.25) %}

{% set y = scaleLinear()
      | domain([0, 55])
      | range(height, 0) %}

<svg width="{{width + margin.left + margin.right}}"
     height="{{height + margin.top + margin.bottom}}"
     xmlns="http://www.w3.org/2000/svg"
     xmlns:v="https://odviz.org/1.0/">

  <metadata>
    <v:table name="Rango CGPA"
             description="Distribución de Rango CGPA"
             visualization="chart"
             columns="ID,CGPA,Cantidad,Color">
      {% for d in data %}
      <v:row id="row-{{d.ID}}" hrefs="bar-{{d.ID}}, label-{{d.ID}}">{{d.ID}},{{d.CGPA}},{{d.Cantidad}},{{d.Color}}</v:row>
      {% endfor %}
    </v:table>
  </metadata>
  <style>
    .tick-label { font-family: sans-serif; font-size: 11px; fill: #333; }
    .axis-line, .tick-line { stroke: #666; }
    .title { font-family: sans-serif; font-size: 13px; font-weight: bold; fill: #111; }
    .axis-label { font-family: sans-serif; font-size: 12px; fill: #555; }
  </style>

  <g transform="translate({{margin.left}},{{margin.top}})">

    <text class="title" x="{{width / 2}}" y="-20" text-anchor="middle">
      Distribución de Estudiantes por Rendimiento Académico (CGPA)
    </text>

    <g transform="translate(0,{{height}})">
      {{ call(axisBottom(x) | tickValues(cats) | tickAngle(25)) }}
    </g>
    <g>{{ call(axisLeft(y) | tickCount(6)) }}</g>

    {% for d in data %}
      <rect id="bar-{{d.ID}}" href="#row-{{d.ID}}"
            x="{{ scale(x, d.CGPA) }}"
            y="{{ scale(y, d.Cantidad) }}"
            width="{{ bandwidth(x) }}"
            height="{{ height - scale(y, d.Cantidad) }}"
            fill="{{ d.Color }}"/>
      <text id="label-{{d.ID}}" href="#row-{{d.ID}}" class="tick-label" text-anchor="middle"
            x="{{ scale(x, d.CGPA) + bandwidth(x) / 2 }}"
            y="{{ scale(y, d.Cantidad) - 4 }}">{{d.Cantidad}}</text>
    {% endfor %}

    <text class="axis-label" text-anchor="middle"
          x="{{width / 2}}" y="{{height + 68}}">Rango de CGPA</text>
    <text class="axis-label" text-anchor="middle"
          transform="rotate(-90)" x="{{0 - height / 2}}" y="-52">Número de Estudiantes</text>
  </g>
</svg>
