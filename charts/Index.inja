<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{{titulo}}</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: Georgia, "Times New Roman", serif;
      font-size: 15px;
      color: #222;
      background: #fff;
      display: flex;
    }

    /* ── Sidebar ── */
    nav.toc {
      position: fixed;
      top: 0; left: 0;
      width: 240px;
      height: 100vh;
      overflow-y: auto;
      background: #f5f5f5;
      border-right: 1px solid #ddd;
      padding: 1.2rem 0;
      font-family: sans-serif;
      font-size: 0.82rem;
    }
    nav.toc .toc-title {
      font-weight: bold;
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: #888;
      padding: 0 1rem 0.5rem;
    }
    nav.toc ul { list-style: none; }
    nav.toc li a {
      display: block;
      padding: 0.25rem 1rem;
      color: #333;
      text-decoration: none;
      line-height: 1.4;
    }
    nav.toc li a:hover { color: #0070c0; }
    nav.toc li.level1 > a { font-weight: 600; color: #111; }
    nav.toc li.level2 > a { padding-left: 1.8rem; color: #444; }
    nav.toc li.level3 > a { padding-left: 2.6rem; color: #666; font-size: 0.78rem; }

    /* ── Main content ── */
    main {
      margin-left: 240px;
      max-width: 820px;
      padding: 2.5rem 3rem 5rem;
      line-height: 1.75;
    }

    /* Title block */
    .title-block {
      margin-bottom: 2.5rem;
      padding-bottom: 1.2rem;
      border-bottom: 1px solid #ddd;
    }
    .title-block h1 {
      font-size: 2rem;
      font-weight: bold;
      line-height: 1.25;
      margin-bottom: 0.6rem;
    }
    .title-block .author { font-size: 0.95rem; color: #444; }
    .title-block .date   { font-size: 0.88rem; color: #888; margin-top: 0.15rem; }

    /* Sections */
    section { margin-bottom: 3rem; }

    h2 {
      font-size: 1.55rem;
      font-weight: bold;
      margin: 2.5rem 0 0.6rem;
      padding-bottom: 0.2rem;
      border-bottom: 1px solid #ddd;
    }
    h3 {
      font-size: 1.15rem;
      font-weight: bold;
      margin: 2rem 0 0.4rem;
      color: #222;
    }

    p { margin-bottom: 0.75rem; }

    /* Charts */
    .chart-block {
      margin: 1.5rem 0 0.5rem;
      text-align: center;
    }
    .chart-block img {
      max-width: 100%;
      height: auto;
      background: #fff;
    }
    .chart-caption {
      font-family: sans-serif;
      font-size: 0.82rem;
      color: #666;
      margin-top: 0.35rem;
    }
  </style>
</head>
<body>

<!-- Sidebar TOC -->
<nav class="toc">
  <div class="toc-title">Tabla de Contenidos</div>
  <ul>
    <li class="level1"><a href="#introduccion">Introducción</a></li>
    <li class="level1"><a href="#descripcion">Descripción del Problema</a></li>
    <li class="level1"><a href="#fuentes">Fuentes de Datos</a></li>
    {% for sec in secciones %}
    <li class="level1"><a href="#{{sec.id}}">{{sec.titulo}}</a></li>
    {% for g in sec.graficas %}
    <li class="level2"><a href="#{{sec.id}}-{{loop.index}}">{{g.titulo}}</a></li>
    {% endfor %}
    {% endfor %}
    <li class="level1"><a href="#conclusiones">Conclusiones</a></li>
  </ul>
</nav>

<!-- Main content -->
<main>

  <div class="title-block">
    <h1>{{titulo}}</h1>
    <p class="author">{{autores}}</p>
    <p class="date">{{fecha}}</p>
  </div>

  <section id="introduccion">
    <h2>Introducción</h2>
    {% for parrafo in introduccion %}
    <p>{{parrafo}}</p>
    {% endfor %}
  </section>

  <section id="fuentes">
    <h2>Fuentes de Datos</h2>
    {% for p in fuentes.parrafos %}
    <p>{{p}}</p>
    {% endfor %}
    <ol style="margin: 0.5rem 0 1rem 1.5rem; line-height: 1.8;">
    {% for paso in fuentes.pasos %}
      <li>{{paso}}</li>
    {% endfor %}
    </ol>
    <p>{{fuentes.cierre}}</p>
  </section>

  <section id="descripcion">
    <h2>Descripción del Problema</h2>
    {% for p in descripcion.parrafos %}
    <p>{{p}}</p>
    {% endfor %}
    <ul style="margin: 0.5rem 0 1rem 1.5rem; line-height: 1.8;">
    {% for q in descripcion.preguntas %}
      <li>{{q}}</li>
    {% endfor %}
    </ul>
    <p>{{descripcion.cierre}}</p>
  </section>

  {% for sec in secciones %}
  <section id="{{sec.id}}">
    <h2>{{sec.titulo}}</h2>
    {% for g in sec.graficas %}
    <h3 id="{{sec.id}}-{{loop.index}}">{{g.titulo}}</h3>
    <p>{{g.analisis}}</p>
    <div class="chart-block">
      <img src="{{g.archivo}}" alt="{{g.titulo}}" />
      <p class="chart-caption">Figura {{g.figura}}. {{g.caption}}</p>
      <p class="chart-caption"><a href="{{g.gist}}" target="_blank">Ver código en Gist →</a></p>
    </div>
    {% endfor %}
  </section>
  {% endfor %}

  <section id="conclusiones">
    <h2>Conclusiones</h2>
    <p>{{conclusiones.intro}}</p>
    <ol style="margin: 0.5rem 0 1rem 1.5rem; line-height: 1.8;">
    {% for c in conclusiones.items %}
      <li><strong>{{c.negrita}}</strong>{{c.texto}}</li>
    {% endfor %}
    </ol>
    <p>{{conclusiones.cierre}}</p>
  </section>

</main>
</body>
</html>
