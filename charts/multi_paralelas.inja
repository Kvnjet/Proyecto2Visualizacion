{% set totalW = 760 %}
{% set totalH = 440 %}
{% set padL   = 60  %}
{% set padT   = 60  %}
{% set padB   = 50  %}
{% set chartW = totalW - padL - 40 %}
{% set chartH = totalH - padT - padB %}
{% set axisStep = chartW / 5 %}
{% set xEd  = 0 %}
{% set xCG  = axisStep %}
{% set xDep = axisStep * 2 %}
{% set xAns = axisStep * 3 %}
{% set xPan = axisStep * 4 %}
{% set xTra = axisStep * 5 %}
{% set yEdad = scaleLinear() | domain([18, 24]) | range(chartH, 0) %}
{% set yCGPA = scaleLinear() | domain([1, 5])   | range(chartH, 0) %}
{% set yBin  = scaleLinear() | domain([0, 1])   | range(chartH, 0) %}
{% set yNo = scale(yBin, 0) %}
{% set ySi = scale(yBin, 1) %}
{% set tk = 4 %}
{% set tko = 7 %}
<svg width="{{totalW}}" height="{{totalH}}" xmlns="http://www.w3.org/2000/svg">
  <style>
    .title      { font-family: sans-serif; font-size: 14px; font-weight: bold; fill: #111; }
    .axis-title { font-family: sans-serif; font-size: 12px; fill: #333; font-weight: bold; }
    .tick-lbl   { font-family: sans-serif; font-size: 10px; fill: #555; }
    .legend-txt { font-family: sans-serif; font-size: 11px; fill: #333; }
  </style>
  <text class="title" x="{{totalW / 2}}" y="30" text-anchor="middle">Perfil Multidimensional del Estudiante</text>
  <g transform="translate({{padL}},{{padT}})">
    {% for d in data %}
      {% set pEd  = scale(yEdad, d.Edad) %}
      {% set pCG  = scale(yCGPA, d.CGPA_val) %}
      {% set pDep = scale(yBin, d.Depresion) %}
      {% set pAns = scale(yBin, d.Ansiedad) %}
      {% set pPan = scale(yBin, d.Panico) %}
      {% set pTra = scale(yBin, d.Tratamiento) %}
      <polyline points="{{xEd}},{{pEd}} {{xCG}},{{pCG}} {{xDep}},{{pDep}} {{xAns}},{{pAns}} {{xPan}},{{pPan}} {{xTra}},{{pTra}}" stroke="{{d.Color}}" stroke-width="1.2" fill="none" opacity="{{d.Opacity}}"/>
    {% endfor %}
    <line x1="{{xEd}}"  y1="0" x2="{{xEd}}"  y2="{{chartH}}" stroke="#555" stroke-width="1.5"/>
    <line x1="{{xCG}}"  y1="0" x2="{{xCG}}"  y2="{{chartH}}" stroke="#555" stroke-width="1.5"/>
    <line x1="{{xDep}}" y1="0" x2="{{xDep}}" y2="{{chartH}}" stroke="#555" stroke-width="1.5"/>
    <line x1="{{xAns}}" y1="0" x2="{{xAns}}" y2="{{chartH}}" stroke="#555" stroke-width="1.5"/>
    <line x1="{{xPan}}" y1="0" x2="{{xPan}}" y2="{{chartH}}" stroke="#555" stroke-width="1.5"/>
    <line x1="{{xTra}}" y1="0" x2="{{xTra}}" y2="{{chartH}}" stroke="#555" stroke-width="1.5"/>
    <text class="axis-title" x="{{xEd}}"  y="-10" text-anchor="middle">Edad</text>
    <text class="axis-title" x="{{xCG}}"  y="-10" text-anchor="middle">CGPA</text>
    <text class="axis-title" x="{{xDep}}" y="-10" text-anchor="middle">Depresion</text>
    <text class="axis-title" x="{{xAns}}" y="-10" text-anchor="middle">Ansiedad</text>
    <text class="axis-title" x="{{xPan}}" y="-10" text-anchor="middle">Panico</text>
    <text class="axis-title" x="{{xTra}}" y="-10" text-anchor="middle">Tratamiento</text>
    {% set xEdL = xEd - tk %}{% set xEdR = xEd + tk %}{% set xEdT = xEd - tko %}
    {% set xCGL = xCG - tk %}{% set xCGR = xCG + tk %}{% set xCGT = xCG - tko %}
    {% set xDepL = xDep - tk %}{% set xDepR = xDep + tk %}{% set xDepT = xDep - tko %}
    {% set xAnsL = xAns - tk %}{% set xAnsR = xAns + tk %}{% set xAnsT = xAns - tko %}
    {% set xPanL = xPan - tk %}{% set xPanR = xPan + tk %}{% set xPanT = xPan - tko %}
    {% set xTraL = xTra - tk %}{% set xTraR = xTra + tk %}{% set xTraT = xTra - tko %}
    {% set ty18 = scale(yEdad, 18) %}{% set ty18o = ty18 + 4 %}
    {% set ty19 = scale(yEdad, 19) %}{% set ty19o = ty19 + 4 %}
    {% set ty20 = scale(yEdad, 20) %}{% set ty20o = ty20 + 4 %}
    {% set ty21 = scale(yEdad, 21) %}{% set ty21o = ty21 + 4 %}
    {% set ty22 = scale(yEdad, 22) %}{% set ty22o = ty22 + 4 %}
    {% set ty23 = scale(yEdad, 23) %}{% set ty23o = ty23 + 4 %}
    {% set ty24 = scale(yEdad, 24) %}{% set ty24o = ty24 + 4 %}
    <line x1="{{xEdL}}" y1="{{ty18}}" x2="{{xEdR}}" y2="{{ty18}}" stroke="#555"/>
    <text class="tick-lbl" x="{{xEdT}}" y="{{ty18o}}" text-anchor="end">18</text>
    <line x1="{{xEdL}}" y1="{{ty19}}" x2="{{xEdR}}" y2="{{ty19}}" stroke="#555"/>
    <text class="tick-lbl" x="{{xEdT}}" y="{{ty19o}}" text-anchor="end">19</text>
    <line x1="{{xEdL}}" y1="{{ty20}}" x2="{{xEdR}}" y2="{{ty20}}" stroke="#555"/>
    <text class="tick-lbl" x="{{xEdT}}" y="{{ty20o}}" text-anchor="end">20</text>
    <line x1="{{xEdL}}" y1="{{ty21}}" x2="{{xEdR}}" y2="{{ty21}}" stroke="#555"/>
    <text class="tick-lbl" x="{{xEdT}}" y="{{ty21o}}" text-anchor="end">21</text>
    <line x1="{{xEdL}}" y1="{{ty22}}" x2="{{xEdR}}" y2="{{ty22}}" stroke="#555"/>
    <text class="tick-lbl" x="{{xEdT}}" y="{{ty22o}}" text-anchor="end">22</text>
    <line x1="{{xEdL}}" y1="{{ty23}}" x2="{{xEdR}}" y2="{{ty23}}" stroke="#555"/>
    <text class="tick-lbl" x="{{xEdT}}" y="{{ty23o}}" text-anchor="end">23</text>
    <line x1="{{xEdL}}" y1="{{ty24}}" x2="{{xEdR}}" y2="{{ty24}}" stroke="#555"/>
    <text class="tick-lbl" x="{{xEdT}}" y="{{ty24o}}" text-anchor="end">24</text>
    {% set tc1 = scale(yCGPA, 1) %}{% set tc1o = tc1 + 4 %}
    {% set tc2 = scale(yCGPA, 2) %}{% set tc2o = tc2 + 4 %}
    {% set tc3 = scale(yCGPA, 3) %}{% set tc3o = tc3 + 4 %}
    {% set tc4 = scale(yCGPA, 4) %}{% set tc4o = tc4 + 4 %}
    {% set tc5 = scale(yCGPA, 5) %}{% set tc5o = tc5 + 4 %}
    <line x1="{{xCGL}}" y1="{{tc1}}" x2="{{xCGR}}" y2="{{tc1}}" stroke="#555"/>
    <text class="tick-lbl" x="{{xCGT}}" y="{{tc1o}}" text-anchor="end">0-1.99</text>
    <line x1="{{xCGL}}" y1="{{tc2}}" x2="{{xCGR}}" y2="{{tc2}}" stroke="#555"/>
    <text class="tick-lbl" x="{{xCGT}}" y="{{tc2o}}" text-anchor="end">2.00-2.49</text>
    <line x1="{{xCGL}}" y1="{{tc3}}" x2="{{xCGR}}" y2="{{tc3}}" stroke="#555"/>
    <text class="tick-lbl" x="{{xCGT}}" y="{{tc3o}}" text-anchor="end">2.50-2.99</text>
    <line x1="{{xCGL}}" y1="{{tc4}}" x2="{{xCGR}}" y2="{{tc4}}" stroke="#555"/>
    <text class="tick-lbl" x="{{xCGT}}" y="{{tc4o}}" text-anchor="end">3.00-3.49</text>
    <line x1="{{xCGL}}" y1="{{tc5}}" x2="{{xCGR}}" y2="{{tc5}}" stroke="#555"/>
    <text class="tick-lbl" x="{{xCGT}}" y="{{tc5o}}" text-anchor="end">3.50-4.00</text>
    {% set yNoO = yNo + 14 %}{% set ySiO = ySi - 3 %}
    <line x1="{{xDepL}}" y1="{{yNo}}" x2="{{xDepR}}" y2="{{yNo}}" stroke="#555"/>
    <text class="tick-lbl" x="{{xDepT}}" y="{{yNoO}}" text-anchor="end">No</text>
    <line x1="{{xDepL}}" y1="{{ySi}}" x2="{{xDepR}}" y2="{{ySi}}" stroke="#555"/>
    <text class="tick-lbl" x="{{xDepT}}" y="{{ySiO}}" text-anchor="end">Si</text>
    <line x1="{{xAnsL}}" y1="{{yNo}}" x2="{{xAnsR}}" y2="{{yNo}}" stroke="#555"/>
    <text class="tick-lbl" x="{{xAnsT}}" y="{{yNoO}}" text-anchor="end">No</text>
    <line x1="{{xAnsL}}" y1="{{ySi}}" x2="{{xAnsR}}" y2="{{ySi}}" stroke="#555"/>
    <text class="tick-lbl" x="{{xAnsT}}" y="{{ySiO}}" text-anchor="end">Si</text>
    <line x1="{{xPanL}}" y1="{{yNo}}" x2="{{xPanR}}" y2="{{yNo}}" stroke="#555"/>
    <text class="tick-lbl" x="{{xPanT}}" y="{{yNoO}}" text-anchor="end">No</text>
    <line x1="{{xPanL}}" y1="{{ySi}}" x2="{{xPanR}}" y2="{{ySi}}" stroke="#555"/>
    <text class="tick-lbl" x="{{xPanT}}" y="{{ySiO}}" text-anchor="end">Si</text>
    <line x1="{{xTraL}}" y1="{{yNo}}" x2="{{xTraR}}" y2="{{yNo}}" stroke="#555"/>
    <text class="tick-lbl" x="{{xTraT}}" y="{{yNoO}}" text-anchor="end">No</text>
    <line x1="{{xTraL}}" y1="{{ySi}}" x2="{{xTraR}}" y2="{{ySi}}" stroke="#555"/>
    <text class="tick-lbl" x="{{xTraT}}" y="{{ySiO}}" text-anchor="end">Si</text>
    {% set legY = chartH + 30 %}
    {% set legYo = legY + 4 %}
    {% set legA = chartW - 200 %}{% set legB = chartW - 180 %}{% set legC = chartW - 175 %}
    {% set legD = chartW - 80 %}{% set legE = chartW - 60 %}{% set legF = chartW - 55 %}
    <line x1="{{legA}}" y1="{{legY}}" x2="{{legB}}" y2="{{legY}}" stroke="#2D68C4" stroke-width="2"/>
    <text class="legend-txt" x="{{legC}}" y="{{legYo}}">Con depresion</text>
    <line x1="{{legD}}" y1="{{legY}}" x2="{{legE}}" y2="{{legY}}" stroke="#F4C430" stroke-width="2"/>
    <text class="legend-txt" x="{{legF}}" y="{{legYo}}">Sin depresion</text>
  </g>
</svg>