{% set totalW = 480 %}
{% set totalH = 420 %}
{% set cx = 240 %}
{% set cy = 215 %}
{% set r  = 140 %}

{% set pieGen = shapePie() | value("Porcentaje") %}
{% set arcGen = shapeArc() | innerRadius(0) | outerRadius(r) %}
{% set slices = pieGen | pie(data) %}

<svg width="{{totalW}}" height="{{totalH}}"
     xmlns="http://www.w3.org/2000/svg"
     xmlns:v="https://odviz.org/1.0/">
  <metadata>
    <v:table name="genero"
             description="Distribución de Estudiantes por Género"
             visualization="chart"
             columns="id,Genero,Porcentaje,Color">
      {% for d in data %}
      <v:row id="row-{{d.id}}" hrefs="path-{{d.id}}, label-{{d.id}}, pct-{{d.id}}">{{d.id}},{{d.Genero}},{{d.Porcentaje}},{{d.Color}}</v:row>
      {% endfor %}
    </v:table>
  </metadata>
  <style>
    .title       { font-family: sans-serif; font-size: 14px; font-weight: bold; fill: #111; }
    .slice-label { font-family: sans-serif; font-size: 13px; fill: white; font-weight: bold; }
  </style>
  <text class="title" x="{{cx}}" y="28" text-anchor="middle">Distribucion de Estudiantes por Genero</text>
  <g transform="translate({{cx}},{{cy}})">
    {% for slice in slices %}
      <path id="path-{{slice.data.id}}" href="#row-{{slice.data.id}}"
            d="{{ arcGen | arc(slice) }}" fill="{{ slice.data.Color }}" stroke="white" stroke-width="2"/>
      <text id="label-{{slice.data.id}}" href="#row-{{slice.data.id}}"
            class="slice-label" x="{{ slice.data.LabelX }}" y="{{ slice.data.LabelY }}" text-anchor="middle">{{ slice.data.Genero }}</text>
      <text id="pct-{{slice.data.id}}" href="#row-{{slice.data.id}}"
            class="slice-label" x="{{ slice.data.LabelX }}" y="{{ slice.data.LabelY2 }}" text-anchor="middle">{{ slice.data.Porcentaje }}%</text>
    {% endfor %}
  </g>
</svg>
