{% set totalW  = 700 %}
{% set totalH  = 420 %}
{% set padL    = 30  %}
{% set padR    = 20  %}
{% set padT    = 60  %}
{% set padB    = 70  %}
{% set gap     = 50  %}
{% set panelW  = (totalW - padL - padR - gap) / 2 %}
{% set panelH  = totalH - padT - padB %}
{% set cats = ["Ansiedad","Depresion","Panico"] %}
<svg width="{{totalW}}" height="{{totalH}}"
     xmlns="http://www.w3.org/2000/svg"
     xmlns:v="https://odviz.org/1.0/">
  <metadata>
    <v:table name="facets_genero"
             description="Condiciones de Salud Mental por Género"
             visualization="chart"
             columns="id,Genero,Condicion,PctYes,PctNo">
      {% for d in data %}
      <v:row id="row-{{d.id}}" hrefs="barNo-{{d.id}}, barYes-{{d.id}}, label-{{d.id}}">{{d.id}},{{d.Genero}},{{d.Condicion}},{{d.PctYes}},{{d.PctNo}}</v:row>
      {% endfor %}
    </v:table>
  </metadata>
  <style>
    .title       { font-family: sans-serif; font-size: 14px; font-weight: bold; fill: #111; }
    .panel-title { font-family: sans-serif; font-size: 13px; font-weight: bold; fill: #333; }
    .tick-label  { font-family: sans-serif; font-size: 11px; fill: #555; }
    .axis-label  { font-family: sans-serif; font-size: 11px; fill: #555; }
    .legend-text { font-family: sans-serif; font-size: 11px; fill: #333; }
    .pct-label   { font-family: sans-serif; font-size: 10px; fill: white; font-weight: bold; }
  </style>
  <text class="title" x="{{totalW / 2}}" y="28" text-anchor="middle">Condiciones de Salud Mental por Genero</text>
  <g transform="translate({{padL}},{{padT}})">
    <text class="panel-title" x="{{panelW / 2}}" y="-10" text-anchor="middle">Mujeres</text>
    {% set x0 = scaleBand() | domain(cats) | range(0, panelW) | padding(0.3) %}
    {% set y0 = scaleLinear() | domain([0, 100]) | range(panelH, 0) %}
    <g transform="translate(0,{{panelH}})">{{ call(axisBottom(x0) | tickValues(cats)) }}</g>
    {% for d in data %}
      {% if d.Genero == "Mujeres" %}
        {% set bx   = scale(x0, d.Condicion) %}
        {% set bw   = bandwidth(x0) %}
        {% set yTop = scale(y0, d.PctYes) %}
        {% set hYes = panelH - yTop %}
        {% set lblX = bx + bw / 2 %}
        {% set lblY = yTop + hYes / 2 + 4 %}
        <rect id="barNo-{{d.id}}" href="#row-{{d.id}}"
              x="{{bx}}" y="0" width="{{bw}}" height="{{panelH}}" fill="#F4C430"/>
        <rect id="barYes-{{d.id}}" href="#row-{{d.id}}"
              x="{{bx}}" y="{{yTop}}" width="{{bw}}" height="{{hYes}}" fill="#2D68C4"/>
        <text id="label-{{d.id}}" href="#row-{{d.id}}"
              class="pct-label" text-anchor="middle" x="{{lblX}}" y="{{lblY}}">{{d.PctYes}}%</text>
      {% endif %}
    {% endfor %}
  </g>
  {% set panelX1 = padL + panelW + gap %}
  <g transform="translate({{panelX1}},{{padT}})">
    <text class="panel-title" x="{{panelW / 2}}" y="-10" text-anchor="middle">Hombres</text>
    {% set x1 = scaleBand() | domain(cats) | range(0, panelW) | padding(0.3) %}
    {% set y1 = scaleLinear() | domain([0, 100]) | range(panelH, 0) %}
    <g transform="translate(0,{{panelH}})">{{ call(axisBottom(x1) | tickValues(cats)) }}</g>
    {% for d in data %}
      {% if d.Genero == "Hombres" %}
        {% set bx   = scale(x1, d.Condicion) %}
        {% set bw   = bandwidth(x1) %}
        {% set yTop = scale(y1, d.PctYes) %}
        {% set hYes = panelH - yTop %}
        {% set lblX = bx + bw / 2 %}
        {% set lblY = yTop + hYes / 2 + 4 %}
        <rect id="barNo-{{d.id}}" href="#row-{{d.id}}"
              x="{{bx}}" y="0" width="{{bw}}" height="{{panelH}}" fill="#F4C430"/>
        <rect id="barYes-{{d.id}}" href="#row-{{d.id}}"
              x="{{bx}}" y="{{yTop}}" width="{{bw}}" height="{{hYes}}" fill="#2D68C4"/>
        <text id="label-{{d.id}}" href="#row-{{d.id}}"
              class="pct-label" text-anchor="middle" x="{{lblX}}" y="{{lblY}}">{{d.PctYes}}%</text>
      {% endif %}
    {% endfor %}
  </g>
  {% set legX  = padL %}{% set legY  = totalH - 20 %}
  {% set legY2 = legY - 11 %}{% set legX2 = legX + 16 %}
  {% set legX3 = legX + 50 %}{% set legX4 = legX + 66 %}{% set legX5 = legX + 90 %}
  <rect x="{{legX}}"  y="{{legY2}}" width="12" height="12" fill="#F4C430"/>
  <text class="legend-text" x="{{legX2}}" y="{{legY}}">No</text>
  <rect x="{{legX3}}" y="{{legY2}}" width="12" height="12" fill="#2D68C4"/>
  <text class="legend-text" x="{{legX4}}" y="{{legY}}">Si</text>
  <text class="legend-text" x="{{legX5}}" y="{{legY}}" font-style="italic">Presenta la condicion</text>
</svg>
